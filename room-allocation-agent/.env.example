# Gemini API key — get free from aistudio.google.com (no credit card needed)
GEMINI_API_KEY=AIza...

# When switching to Anthropic later, replace GEMINI_API_KEY with:
# ANTHROPIC_API_KEY=sk-ant-...
# and change agent.py model to "anthropic:claude-sonnet-4-6"

# Base URL of your NestJS backend (no trailing slash)
NEST_BASE_URL=http://localhost:4000

# Allowed origin for CORS (your React app URL)
CORS_ORIGIN=http://localhost:3000
