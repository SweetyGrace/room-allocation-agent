pipeline {
    agent any
    environment {
        // fd_secret_ignore
        GOOGLE_CHAT_URL = "https://chat.googleapis.com/v1/spaces/AAAA6Wtz7Xg/messages?key=AIzaSyDdI0hCZtE6vySjMm-WEfRq3CPzqKqqsHI&token=UcaW1-lHiYQtM06nI_Ng6nxuBdpI44N6cYyrpuzeG4k"
        S3_BUCKET_NAME = "portal-admin-uat-frontendbucket"
        CLOUDFRONT_DISTRIBUTION_ID = "ES7KSFSC0MWDB"
        BRANCH_NAME = "portal-admin-uat"
        ENV_S3_BUCKET_PATH = "allenvironmentvariables/portal/frontend/admin-uat.env"
        ENVIRONMENT = "admin-uat"
        AWS_PROFILE = "hdb-client-ha-mum"
        APP_URL = "https://portaladmin.uat.infinitheism.com"
        NODE_INSTALLATION = "Infini-Portal"
    }
    stages {
         stage('get_commit_msg') {
            steps {
                script {
                    env.GIT_COMMIT_MSG = sh (script: 'git log -1 --pretty=%B ${GIT_COMMIT}', returnStdout: true).trim()
                    GIT_COMMIT_EMAIL = sh (
                        script: 'git --no-pager show -s --format=\'%ae\'',
                        returnStdout: true
                    ).trim()
                    echo "Git committer email: ${GIT_COMMIT_EMAIL}"
                    echo "${GIT_COMMIT_MSG}"
                }
            }
        }
        stage('Setup Environment variables') {
            steps {
                script {
                    sh 'aws s3 cp s3://${ENV_S3_BUCKET_PATH} ./.env --profile ${AWS_PROFILE}'
                }
            }
        }
        stage('build') {
            steps {
                nodejs("${env.NODE_INSTALLATION}") {
                    echo 'building'
                    sh 'npm cache clean --force'
                    sh 'npm i @babel/runtime --force'
                    sh 'npm i react-lottie --force'
                    sh 'npm install --force'
                    script {
                        echo "${ENVIRONMENT} Build"
                        sh 'npm run build'
                    }
                }
            }
        }
        stage('Deployment') {
            steps {
                script {
                    echo "${ENVIRONMENT} deployment started"
                    sh 'aws s3 cp ./build s3://${S3_BUCKET_NAME} --recursive --profile ${AWS_PROFILE}'
                    sh 'aws cloudfront create-invalidation --distribution-id ${CLOUDFRONT_DISTRIBUTION_ID} --paths "/*" --profile ${AWS_PROFILE}'
                    echo "${ENVIRONMENT} deployment Completed"
                }
            }
        }
    }
    post {
        always {
            script {
                def message = "Project Name: ${JOB_NAME}\n" +
                                "Build Number: ${BUILD_NUMBER}\n" +
                                "Git Branch: ${GIT_BRANCH}\n" +
                                "Environment: ${ENVIRONMENT}\n"

                def buildResult = currentBuild.currentResult
                if (buildResult == "SUCCESS") {
                    message +=  "Output: ${APP_URL}\n" +
                                "Build Result: Success"
                } 
                else {
                    message += "Output Log: ${RUN_DISPLAY_URL}\n" +
                                "Build Result: Failed"
                }
                googlechatnotification message: message, url: "${GOOGLE_CHAT_URL}"
                cleanWs()
            }
        }
    }
}
